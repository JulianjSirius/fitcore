{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "identity", "Match": { "Path": "/api/Auth/{**rest}" } },
      "usuarios": { "ClusterId": "identity", "Match": { "Path": "/api/Usuario/{**rest}" } },
      "entrenadores": { "ClusterId": "identity", "Match": { "Path": "/api/Entrenador/{**rest}" } },
      "administradores": { "ClusterId": "identity", "Match": { "Path": "/api/Administrador/{**rest}" } },
      "codigos-registro": { "ClusterId": "identity", "Match": { "Path": "/api/CodigoRegistro/{**rest}" } },
      "planes": { "ClusterId": "identity", "Match": { "Path": "/api/Plan/{**rest}" } },
      "membresias": { "ClusterId": "identity", "Match": { "Path": "/api/Membresia/{**rest}" } },
      "acceso": { "ClusterId": "identity", "Match": { "Path": "/api/Acceso/{**rest}" } },
      "ejercicios": { "ClusterId": "workouts", "Match": { "Path": "/api/Ejercicios/{**rest}" } },
      "rutinas": { "ClusterId": "workouts", "Match": { "Path": "/api/Rutinas/{**rest}" } },
      "progreso": { "ClusterId": "workouts", "Match": { "Path": "/api/Progreso/{**rest}" } }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "identity-api": { "Address": "http://localhost:5231/" } }
      },
      "workouts": {
        "Destinations": { "workouts-api": { "Address": "http://localhost:5000/" } }
      }
    }
  }
}
